---
import BaseLayout from "../layouts/BaseLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import T from "../components/T.astro";
---

<BaseLayout
  title="CV"
  description="Sunhyuk Hwang — Academic CV. Satellite RF security researcher."
  sidebar
>
  <div class="cv-paper">
    {/* ── Header ── */}
    <div class="cv-header">
      <div class="cv-header-text">
        <h1><T en="SUNHYUK HWANG" ko="황선혁" /></h1>
        <p class="cv-role"><T en="M.S. candidate, Cybersecurity — Kyung Hee University" ko="경희대학교 정보보호학과 석사과정" /></p>
        <p class="cv-advisor"><T en="Advisor: Prof. Dae-Hee Jang (PWNLAB)" ko="지도교수: 장대희 교수 (PWNLAB)" /></p>
        <p class="cv-tagline"><T en="Satellite Cybersecurity · wireless protocol analysis" ko="위성 사이버보안 · 무선 프로토콜 분석" /></p>
        <div class="cv-actions">
          <a
            class="cv-download"
            href="/SunHyuk_Hwang_CV.pdf"
            download="SunHyuk_Hwang_CV.pdf"
            aria-label="Download CV (PDF)"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Download CV (PDF)</span>
          </a>
          <a class="cv-link" href="mailto:ericwhale0@gmail.com">
            Email ↗
          </a>
        </div>
      </div>
      {/* Photo hidden — US academic CV norm is to omit photos to reduce
          unconscious bias. Image file kept at /public/cv-photo.jpg in case
          a Korean-industry version needs to restore it. */}
      {/*
      <div class="cv-photo-wrap">
        <img src="/cv-photo.jpg" alt="Sunhyuk Hwang" class="cv-photo" width="360" height="432" />
      </div>
      */}
    </div>

    {/* ── Research Interests ── */}
    <div class="cv-section">
      <h2>// <T en="Research Interests" ko="연구 관심분야" /></h2>
      <p>
        <T
          en="I work on the security of satellite systems, with a current focus on the RF and communication-protocol layer — signal reception, protocol analysis, and exploitation. A through-line in my work is building open tools and simulators that make this research hands-on and reproducible without specialized hardware. I aim to extend this from the RF link into the software that runs spacecraft — onboard flight and ground-segment systems."
          ko="위성 시스템 보안을 연구하며, 현재는 RF 및 통신 프로토콜 계층 — 신호 수신, 프로토콜 분석, 익스플로잇 — 에 집중하고 있습니다. 비싼 RF 장비 없이도 연구를 직접 수행하고 재현할 수 있도록 오픈 도구와 시뮬레이터를 만들어 위성 해킹 시나리오를 구현하고 실증할 수 있도록 하는 등 소프트웨어 개발도 진행한 바 있습니다. 앞으로는 RF 링크를 넘어, 위성을 구동하는 소프트웨어 — 탑재(비행) 소프트웨어와 지상국 시스템 — 까지 위성 보안 전반으로 연구를 확장하고자 합니다."
        />
      </p>
    </div>

    {/* ── Education ── */}
    <div class="cv-section">
      <h2>// <T en="Education" ko="학력" /></h2>

      <div class="cv-entry">
        <div class="cv-entry-head">
          <h3><T en="M.S., Cybersecurity — Kyung Hee University" ko="컴퓨터공학 (정보보호) 석사 — 경희대학교" /></h3>
          <span class="cv-date"><T en="Mar 2025 – Feb 2027 (expected)" ko="2025.03 – 2027.02 (졸업 예정)" /></span>
        </div>
        <ul>
          <li>
            <span class="lang-en">Graduate researcher, <a href="https://pwnlab.kr/" target="_blank" rel="noopener">PWNLAB</a> cybersecurity research lab (2025 – present)</span><span class="lang-ko"><a href="https://pwnlab.kr/" target="_blank" rel="noopener">PWNLAB</a> 정보보안 연구실 대학원 연구원 (2025 – 현재)</span>
          </li>
          <li><T en="Research focus: Satellite communication security" ko="연구 분야: 위성 통신 보안" /></li>
          <li><T en="GPA: 4.17/4.3 (in progress)" ko="학점: 4.17 / 4.3 (재학 중)" /></li>
          <li>
            <span class="lang-en">Thesis: <em>A Study on the Design of a Virtual Satellite Antenna (VSA) System for Satellite RF Hacking Research</em> (TBD)</span><span class="lang-ko">학위논문: <em>A Study on the Design of a Virtual Satellite Antenna (VSA) System for Satellite RF Hacking Research</em> (예정)</span>
          </li>
        </ul>
      </div>

      <div class="cv-entry">
        <div class="cv-entry-head">
          <h3><T en="B.S., Computer Engineering — Kyung Hee University" ko="컴퓨터공학 학사 — 경희대학교" /></h3>
          <span class="cv-date"><T en="Mar 2019 – Feb 2025" ko="2019.03 – 2025.02" /></span>
        </div>
        <ul>
          <li><span class="lang-en">Undergraduate researcher, PWNLAB cybersecurity research lab (2023 – 2024)</span><span class="lang-ko">PWNLAB 정보보안 연구실 학부 연구생 (2023 – 2024)</span></li>
          <li><T en="Research focus: Drone security" ko="연구 분야: 드론 보안, 시스템 보안" /></li>
        </ul>
      </div>
    </div>

    {/* ── Publications ── */}
    <div class="cv-section">
      <h2>// <T en="Publications" ko="발표 논문" /></h2>
      <ol class="cv-pubs">
        <li>
          <span class="cv-pub-flag" aria-label="Korea">🇰🇷</span>
          <strong>
            "Design and Implementation of a Virtual Satellite Antenna System
            for Satellite RF Hacking Research."
          </strong>
          Conference on Information Security and Cryptography — Summer
          (CISC-S'26), Busan, Korea. May 8, 2026. <em><T en="Oral presentation." ko="구두 발표." /></em>
        </li>
        <li>
          <span class="cv-pub-flag" aria-label="Korea">🇰🇷</span>
          <strong>"Analysis of Security Threats in Satellite Control Communication Using the NOS3 Satellite System Simulator."</strong>
          Conference on Information Security and Cryptography (CISC-W'24),
          Nov 2024. ·
          <a
            class="paper-link"
            href="https://www.dbpia.co.kr/journal/articleDetail?nodeId=NODE12160174"
            target="_blank"
            rel="noopener"
          ><T en="view paper ↗" ko="논문 보기 ↗" /></a>
        </li>
        <li>
          <span class="cv-pub-flag" aria-label="Korea">🇰🇷</span>
          <strong>"Research on Exploiting Open Source Ground Stations through Satellite Spoofing Signal."</strong>
          Korea Computer Congress (KCC 2024), Jun 2024. ·
          <a
            class="paper-link"
            href="https://www.dbpia.co.kr/journal/articleDetail?nodeId=NODE11862517"
            target="_blank"
            rel="noopener"
          ><T en="view paper ↗" ko="논문 보기 ↗" /></a>
        </li>
        <li>
          <span class="cv-pub-flag" aria-label="Korea">🇰🇷</span>
          <strong>"Analysis of the Communication Protocol in Open-Source Drone (PX4)."</strong>
          Conference on Information Security and Cryptography — Winter
          (CISC-W'23), Dec 2023.
        </li>
      </ol>
    </div>

    {/* ── Research Experience ── */}
    <div class="cv-section">
      <h2>// <T en="Research Experience" ko="연구 경력" /></h2>

      <div class="cv-project">
        <div class="cv-entry-head">
          <h3><T en="Graduate Researcher — Satellite Cybersecurity" ko="대학원 연구원 — 위성 사이버보안" /></h3>
          <span class="cv-date"><T en="Mar 2025 – present" ko="2025.03 – 현재" /></span>
        </div>
        <p class="cv-org"><T en="PWNLAB, Kyung Hee University" ko="PWNLAB, 경희대학교" /></p>
        <ul>
          <li>
            <T
              en="Research on the RF and protocol layer of satellite security — operating real and virtualized ground stations to study signal reception, tracking, and exploitation."
              ko="위성 보안의 RF 및 프로토콜 계층을 연구하며, 실제 및 가상화된 지상국을 운용해 신호 수신·추적·익스플로잇을 연구합니다."
            />
          </li>
          <li>
            <span class="lang-en">Creator of <a href="https://github.com/whal-e3/OpenVSA" target="_blank" rel="noopener">OpenVSA</a> and <a href="https://mrradio.kr/" target="_blank" rel="noopener">Mr.Radio</a> (detailed under Selected Projects) — open tools that make satellite RF security research and education hands-on.</span><span class="lang-ko"><a href="https://github.com/whal-e3/OpenVSA" target="_blank" rel="noopener">OpenVSA</a>와 <a href="https://mrradio.kr/" target="_blank" rel="noopener">Mr.Radio</a> 개발 (주요 프로젝트에 상세) — 가상화된 위성 통신 환경에서 위성 보안 연구 및 교육을 직접 해볼 수 있게 해주는 도구입니다.</span>
          </li>
        </ul>
      </div>

      <div class="cv-project">
        <div class="cv-entry-head">
          <h3><T en="Ground System Lead (RLE) — KARI-hosted CubeSat competition" ko="지상국 소프트웨어 총괄 (RLE) — KARI 주최 큐브위성 경진대회" /></h3>
          <span class="cv-date"><T en="Jun 2026 – present" ko="2026.06 – 현재" /></span>
        </div>
        <p class="cv-org">
          <span class="lang-en">KHU team · <a href="https://www.kari.re.kr/kor/article/ATCL90a22172e/18676" target="_blank" rel="noopener">7th Korean CubeSat Competition</a> (KASA / KARI)</span><span class="lang-ko">경희대학교 팀 · <a href="https://www.kari.re.kr/kor/article/ATCL90a22172e/18676" target="_blank" rel="noopener">제7회 한국 큐브위성 경진대회</a> (KASA / KARI)</span>
        </p>
        <ul>
          <li>
            <T
              en="Lead the ground-system software segment; designing the Mission Operations Center (MOC) that commands the satellite and processes its telemetry and mission data."
              ko="지상국 소프트웨어 파트를 총괄하며, 위성에 명령을 전송하고 텔레메트리·임무 데이터를 처리하는 관제센터(MOC)를 설계합니다."
            />
          </li>
        </ul>
      </div>

      <div class="cv-project">
        <div class="cv-entry-head">
          <h3><T en="Researcher — Satellite Cybersecurity R&D Project" ko="연구원 — 위성 사이버보안 R&D 과제" /></h3>
          <span class="cv-date">2024 – 2025</span>
        </div>
        <p class="cv-org"><T en="Korean government research institutes" ko="국내 정부출연연구기관" /></p>
        <ul>
          <li><T en="Government-funded defense satellite security research." ko="정부지원 국방 위성 보안 연구." /></li>
        </ul>
      </div>
    </div>

    {/* ── Teaching Experience ── */}
    <div class="cv-section">
      <h2>// <T en="Teaching Experience" ko="강의 경력" /></h2>

      <div class="cv-project">
        <div class="cv-entry-head">
          <h3><T en="Teaching Assistant — Information Security (Undergraduate)" ko="조교(TA) — 정보보안 (학부)" /></h3>
          <span class="cv-date"><T en="Jun 2026" ko="2026.06" /></span>
        </div>
        <p class="cv-org"><T en="Kyung Hee University · Instructor: Prof. Dae-Hee Jang" ko="경희대학교 · 담당교수: 장대희 교수" /></p>
        <ul>
          <li>
            <T
              en="Led two hands-on RF-hacking lab sessions covering RF attack fundamentals and practical signal exploitation."
              ko="RF 공격 기초와 실전 신호 익스플로잇을 다루는 실습형 RF 해킹 수업 및 실습을 진행했습니다."
            />
          </li>
        </ul>
      </div>

      <div class="cv-project">
        <div class="cv-entry-head">
          <h3><T en="RF Security Instructor — PWNLAB" ko="RF 보안 랩 세미나 — PWNLAB" /></h3>
          <span class="cv-date"><T en="Mar 2024 – present" ko="2024.03 – 현재" /></span>
        </div>
        <p class="cv-org"><T en="PWNLAB, Kyung Hee University" ko="PWNLAB, 경희대학교" /></p>
        <ul>
          <li>
            <T
              en="Designed and deliver internal RF-security training for lab members, introducing RF attack surfaces and hands-on exploitation techniques."
              ko="연구실 구성원을 위한 내부 RF 보안 교육을 직접 설계·진행하며, RF 공격 표면과 실전 익스플로잇 기법을 소개합니다."
            />
          </li>
        </ul>
      </div>
    </div>

    {/* ── Talks & Demonstrations ── */}
    <div class="cv-section">
      <h2>// <T en="Talks & Demonstrations" ko="발표 및 시연" /></h2>

      <div class="cv-project">
        <div class="cv-entry-head">
          <h3>DEF CON 2026 Aerospace Village</h3>
          <span class="cv-date"><T en="Aug 2026" ko="2026.08" /></span>
        </div>
        <p>
          <T
            en="Co-developed and present hands-on satellite-hacking scenarios built on OpenVSA, in collaboration with IERAE, for visitors at the Aerospace Village, Las Vegas, NV, USA."
            ko="IERAE와 협력하여 OpenVSA 기반의 실습형 위성 해킹 시나리오를 공동 개발하고, 미국 라스베이거스 Aerospace Village에서 방문객을 대상으로 시연했습니다."
          />
        </p>
      </div>

    </div>

    {/* ── Selected Projects ── */}
    <div class="cv-section">
      <h2>// <T en="Selected Projects" ko="주요 프로젝트" /></h2>

      <div class="cv-project">
        <h4>
          VSA / <a href="https://github.com/whal-e3/OpenVSA" target="_blank" rel="noopener">OpenVSA</a>
          — Virtual Satellite Antenna
        </h4>
        <p>
          <T
            en="Desktop application that virtualizes a full satellite ground station — GPredict integration for real-time tracking, IQ signal-file analysis, and multi-antenna beam-pattern simulation — enabling hands-on satellite RF security research without physical hardware."
            ko="안테나를 비롯한 위성 지상국을 가상화하는 desktop 애플리케이션입니다. GPredict 연동 실시간 추적, IQ 신호 파일 분석, 신호 시뮬레이션을 지원하여, 하드웨어 장비 없이도 위성 RF 보안 연구를 수행할 수 있게 합니다."
          />
        </p>
      </div>

      <div class="cv-project">
        <h4>
          Mr.Radio — <a href="https://mrradio.kr" target="_blank" rel="noopener">mrradio.kr</a>
        </h4>
        <p>
          <T
            en="Browser-based RF-hacking wargame with virtualized signal environments — reception, demodulation, and decoding without physical SDR hardware. Challenges span general RF hacking up to satellite communication hacking, so players build RF fundamentals and then take on satellite comms. Over 150 registered users."
            ko="신호 환경을 가상화한 브라우저 기반 RF 해킹 워게임입니다. 물리 SDR 장비 없이 신호 수신·복조·디코딩을 수행할 수 있습니다. 일반적인 RF 해킹 문제부터 위성 통신 해킹까지 다루어, RF 해킹의 기본기를 익힌 뒤 위성 통신 해킹까지 직접 해볼 수 있도록 제작했습니다. 현재 150명 이상의 가입 사용자를 확보했습니다."
          />
        </p>
      </div>

      <div class="cv-project">
        <h4>
          <a href="http://hackthedrone.org/" target="_blank" rel="noopener">Hack-the-Drone CTF</a>
          — RF Challenges (2023, 2024)
        </h4>
        <p>
          <T
            en="Created challenges — including drone RF hacking — across 2023 and 2024, and helped run the competition, including building the finals event server in 2023."
            ko="2023년, 2024년 두 해에 걸쳐 드론 RF 해킹을 비롯한 챌린지들을 제작하고, 2023년에는 본선을 위한 대회 서버를 구축하는 등 드론 해킹 대회 운영에 참여했습니다."
          />
        </p>
      </div>
    </div>

    {/* ── Honors & Awards ── */}
    <div class="cv-section">
      <h2>// <T en="Honors & Awards" ko="수상 경력" /></h2>
      <ul>
        <li><span class="lang-en"><strong>AUTOCRYPT Special Award</strong> — Automotive Hacking Competition (AutoHack).</span><span class="lang-ko"><strong>AUTOCRYPT 특별상</strong> — 자동차 해킹 경진대회 (AutoHack).</span></li>
        <li><span class="lang-en"><strong>Hacktaeon CTF Finalist</strong> — National CTF hosted by Sejong City.</span><span class="lang-ko"><strong>핵태온 CTF 본선 진출</strong> — 세종시 주최 전국 CTF.</span></li>
      </ul>
    </div>

    {/* ── Technical Skills ── */}
    <div class="cv-section">
      <h2>// <T en="Technical Skills" ko="기술 역량" /></h2>
      <dl class="skills-list">
        <div class="skill-row">
          <dt><T en="Software-defined radio" ko="SDR" /></dt>
          <dd>
            <T
              en="Hands-on satellite RF work across the full stack — from installing and aiming antennas to receive live satellite signals, through SDR hardware (e.g. HackRF One, USRP), to analysis software (e.g. GNU Radio, Inspectrum) for demodulation and decoding."
              ko="안테나 설치·지향으로 실제 위성 신호를 수신하는 단계부터, SDR 하드웨어(예: HackRF One, USRP), 복조·디코딩을 위한 분석 소프트웨어(예: GNU Radio, Inspectrum)까지 다룰 수 있습니다."
            />
          </dd>
        </div>
        <div class="skill-row">
          <dt><T en="Satellite systems" ko="위성 시스템" /></dt>
          <dd>
            <T
              en="Working knowledge of satellite communication protocols, the NOS3 satellite simulator, NASA's core Flight System (cFS) flight software framework, the TinyGS ground-station stack, and the CCSDS standard protocol."
              ko="위성 통신 프로토콜, NOS3 위성 시뮬레이터, NASA의 cFS(core Flight System) 비행 소프트웨어 프레임워크, TinyGS 지상국 스택, CCSDS 표준 프로토콜에 대한 지식을 갖추고 있습니다."
            />
          </dd>
        </div>
        <div class="skill-row">
          <dt><T en="Systems hacking" ko="시스템 해킹" /></dt>
          <dd>
            <T
              en="Reverse engineering and binary exploitation using tools like IDA Pro."
              ko="IDA Pro 등의 소프트웨어 분석 도구를 활용한 리버스 엔지니어링 및 pwning 방법을 이해하고 있습니다."
            />
          </dd>
        </div>
      </dl>
    </div>

  </div><!-- /.cv-paper -->

  <Sidebar slot="sidebar" />
</BaseLayout>

<style is:global>
  /* Widen the main content column on the CV page so the paper can breathe */
  .main-content:has(.cv-paper) {
    max-width: 1080px;
  }
</style>

<style>
  .cv-paper {
    background: rgba(10, 5, 16, 0.62);
    border: 1px solid rgba(245, 230, 212, 0.12);
    border-radius: 16px;
    padding: 48px 60px 44px;
    box-shadow:
      0 10px 40px rgba(0, 0, 0, 0.5),
      inset 0 0 60px rgba(245, 230, 212, 0.02);
  }

  /* ── Core CV section typography ── */
  .cv-section {
    margin-bottom: 44px;
  }
  .cv-section h2 {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: 20px;
  }
  .cv-section h3 {
    font-family: var(--font-header);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
  }
  .cv-section h4 {
    font-family: var(--font-header);
    font-size: 1.05rem;
    font-weight: 600;
