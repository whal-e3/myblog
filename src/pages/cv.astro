<script>
  // CV PDF button: show a popup toast when clicked (PDF not ready yet)
  function wireCvDownload() {
    const btn = document.querySelector<HTMLButtonElement>("[data-cv-download]");
    if (!btn || btn.dataset.wired) return;
    btn.dataset.wired = "1";

    btn.addEventListener("click", () => {
      // Remove any existing toast first
      document.querySelectorAll(".cv-toast").forEach((t) => t.remove());

      const toast = document.createElement("div");
      toast.className = "cv-toast";
      toast.textContent = "PDF is being prepared — check back soon.";
      document.body.appendChild(toast);

      // Force reflow then animate in
      requestAnimationFrame(() => toast.classList.add("is-visible"));

      // Animate out after 2.5s, remove after animation
      setTimeout(() => {
        toast.classList.remove("is-visible");
        setTimeout(() => toast.remove(), 300);
      }, 2500);
    });
  }
  wireCvDownload();
  document.addEventListener("astro:page-load", wireCvDownload);
</script>

<style is:global>
  /* Widen the main content column on the CV page so the paper can breathe */
  .main-content:has(.cv-paper) {
    max-width: 1080px;
  }

  /* Toast pop-up for the Download-CV button (global because the element
     is created dynamically by JS and scoped styles wouldn't match it) */
  .cv-toast {
    position: fixed;
    top: calc(var(--header-height, 64px) + 16px);
    left: 50%;
    transform: translateX(-50%) translateY(-12px);
    background: #120a18;
    border: 1px solid #7dc7f5;
    color: #fff1dc;
    padding: 12px 20px;
    border-radius: 10px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.9rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
    z-index: 9999;
  }
  .cv-toast.is-visible {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
</style>

<style>
  .cv-paper {
    background: rgba(10, 5, 16, 0.62);
    border: 1px solid rgba(245, 230, 212, 0.12);
    border-radius: 16px;
    padding: 48px 60px 44px;
    box-shadow:
      0 10px 40px rgba(0, 0, 0, 0.5),
      inset 0 0 60px rgba(245, 230, 212, 0.02);
  }

  /* ── Core CV section typography ── */
  .cv-section {
    margin-bottom: 44px;
  }
  .cv-section h2 {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: 20px;
  }
  .cv-section h3 {
    font-family: var(--font-header);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
  }
  .cv-section h4 {
    font-family: var(--font-header);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent-blue);
    margin-bottom: 10px;
  }
  .cv-section p,
  .cv-section li {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.7;
  }
  .cv-section ul {
    padding-left: 20px;
    margin: 8px 0 0;
  }
  .cv-section li {
    margin: 6px 0;
  }
  .cv-date {
    font-family: var(--font-mono);
    font-size: 0.86rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }
  /* Project / research cards (reused for Research Experience + Selected Projects) */
  .cv-project {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 22px;
    margin-bottom: 16px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
  }
  .cv-project:last-child {
    margin-bottom: 0;
  }
  .cv-project p {
    margin: 4px 0;
  }

  /* ── Header: text left, photo right ── */
  .cv-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 44px;
  }
  .cv-header-text {
    flex: 1;
    min-width: 0;
  }
  .cv-header h1 {
    margin: 0;
    letter-spacing: 0.02em;
  }
  .cv-role {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: var(--text-secondary);
    margin-top: 6px;
    letter-spacing: 0.02em;
  }
  .cv-advisor {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    color: var(--text-secondary);
    letter-spacing: 0.02em;
    margin-top: 4px;
  }
  .cv-tagline {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    line-height: 1.7;
    margin-top: 8px;
  }

  /* Header actions (download + LinkedIn) */
  .cv-actions {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .cv-paper .cv-download {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border: 1px solid rgba(125, 199, 245, 0.45);
    border-radius: 8px;
    background: var(--accent-dim);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: all 0.15s;
  }
  .cv-paper .cv-download:hover {
    background: rgba(125, 199, 245, 0.22);
    color: var(--accent-strong);
    text-decoration: none;
    border-color: var(--accent);
  }
  .cv-paper .cv-download svg { flex-shrink: 0; }
  .cv-paper .cv-link {
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: all 0.15s;
  }
  .cv-paper .cv-link:hover {
    color: var(--accent-blue);
    border-color: var(--accent-blue);
    text-decoration: none;
  }

  /* Photo */
  .cv-photo-wrap {
    flex-shrink: 0;
  }
  .cv-photo {
    width: 140px;
    height: 168px;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid rgba(245, 230, 212, 0.18);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.5);
    display: block;
  }

  /* Last section has no bottom margin */
  .cv-paper .cv-section:last-child { margin-bottom: 0; }

  /* Section note (small italic under section header) */
  .cv-section-note {
    font-size: 0.82rem;
    color: var(--text-muted);
    font-style: italic;
    margin-bottom: 12px;
  }

  /* CV entry layout — h3 + dates on one row */
  .cv-entry { margin-bottom: 22px; }
  .cv-entry:last-child { margin-bottom: 0; }
  .cv-entry-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
  }
  .cv-entry-head h3 { margin-bottom: 0; }
  .cv-entry-head .cv-date {
    margin-bottom: 0;
    flex-shrink: 0;
  }
  .cv-entry ul { margin-top: 8px; }

  /* Research / Selected Projects */
  .cv-project .cv-entry-head h3 {
    font-size: 1.05rem;
    color: var(--text-primary);
  }
  .cv-org {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--accent-blue);
    margin-top: 2px;
    margin-bottom: 8px;
  }

  /* Coursework grid */
  .coursework-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
  }
  .coursework-grid h4 {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-blue);
    margin-bottom: 8px;
  }
  .coursework-list {
    list-style: none;
    padding-left: 0;
    margin: 0;
  }
  .coursework-list li {
    padding-left: 14px;
    position: relative;
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }
  .coursework-list li::before {
    content: "·";
    color: var(--accent);
    position: absolute;
    left: 0;
    font-weight: 700;
  }

  /* Publications list */
  .cv-pubs {
    padding-left: 24px;
    margin: 8px 0;
  }
  .cv-pubs li {
    margin-bottom: 14px;
    line-height: 1.6;
  }
  .cv-pubs li::marker {
    color: var(--accent);
    font-family: var(--font-mono);
  }
  .cv-pub-en {
    display: block;
    font-size: 0.88rem;
    color: var(--text-muted);
    font-style: italic;
    margin-top: 2px;
  }
  .cv-pub-flag {
    display: inline-block;
    margin-right: 6px;
    font-size: 1em;
    line-height: 1;
    vertical-align: baseline;
  }

  /* Talks list — slightly tighter */
  .cv-talks li { margin-bottom: 6px; }

  /* Inline meta info (dates in presentation/teaching lists) */
  .cv-meta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-left: 4px;
  }

  /* Inline links inside the CV — distinct color from titles */
  .cv-paper a {
    color: var(--accent-blue);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: rgba(74, 158, 255, 0.4);
    transition: color 0.15s, text-decoration-color 0.15s;
  }
  .cv-paper a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
  .cv-paper .cv-download,
  .cv-paper .cv-link {
    text-decoration: none;
  }
  /* Bold/title text stays in primary color, never link-colored */
  .cv-paper strong {
    color: var(--text-primary);
  }

  /* Skills list — flat definition-list style (row-per-group) */
  .skills-list {
    margin: 0;
  }
  .skill-row {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 20px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .skill-row:last-child {
    border-bottom: none;
  }
  .skill-row dt {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-blue);
    padding-top: 2px;
  }
  .skill-row dd {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 768px) {
    .cv-paper {
      padding: 28px 22px 24px;
      border-radius: 12px;
    }
    .cv-header {
      flex-direction: column-reverse;  /* photo on top for mobile */
      align-items: flex-start;
      gap: 18px;
    }
    .cv-photo {
      width: 110px;
      height: 132px;
