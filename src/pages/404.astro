---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 — Lost in space" description="Page not found.">
  <section class="notfound">
    <div class="notfound-code">404</div>
    <h1 class="notfound-title">Signal lost.</h1>
    <p class="notfound-message">
      The page you're looking for has drifted beyond range, was never here,
      or got swallowed by a black hole.
    </p>
    <div class="notfound-actions">
      <a href="/" class="notfound-link">← Return to base</a>
      <a href="/blog" class="notfound-link">Browse the blog →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    text-align: center;
    padding: 80px 24px 100px;
    max-width: 640px;
    margin: 0 auto;
  }

  .notfound-code {
    font-family: var(--font-mono);
    font-size: clamp(5rem, 18vw, 9rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    background: linear-gradient(135deg,
      var(--accent) 0%,
      var(--accent-strong) 40%,
      var(--accent-blue) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: drop-shadow(0 4px 32px rgba(255, 107, 42, 0.3));
    margin-bottom: 14px;
  }

  .notfound-title {
    font-family: var(--font-header);
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    margin-bottom: 14px;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.6);
  }

  .notfound-message {
    color: var(--text-secondary);
    font-size: 1.02rem;
    line-height: 1.65;
    margin-bottom: 36px;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }

  .notfound-actions {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .notfound-link {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    color: var(--accent);
    padding: 10px 18px;
    border: 1px solid rgba(255, 107, 42, 0.4);
    border-radius: 8px;
    background: var(--accent-dim);
    text-decoration: none;
    transition: all 0.15s;
    letter-spacing: 0.04em;
  }
  .notfound-link:hover {
    color: var(--accent-strong);
    border-color: var(--accent);
    background: rgba(255, 107, 42, 0.22);
  }

  @media (max-width: 640px) {
    .notfound { padding: 48px 16px 72px; }
    .notfound-title { font-size: 1.5rem; }
    .notfound-message { font-size: 0.95rem; }
    .notfound-link { padding: 9px 14px; font-size: 0.82rem; }
    .notfound-actions { gap: 12px; }
  }
</style>
