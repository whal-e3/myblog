---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import Sidebar from "../components/Sidebar.astro";
import T from "../components/T.astro";
import { getCollection } from "astro:content";

const now = new Date();
const allPosts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .filter((p) => !p.data.publishDate || p.data.publishDate <= now);

const starred = allPosts
  .filter((p) => p.data.starred)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const recent = [...allPosts]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// Latest 4 projects, by the same chronological order used on /projects
// (lower order = more recent).
const latestProjects = (await getCollection("projects"))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<BaseLayout title="sunhyuk.dev" sidebar>
  <section class="hero">
    <h1 class="hero-title">SunHyuk Hwang</h1>
    <p class="hero-focus">
      I'm a space security researcher focused on satellites — their RF links,
      protocols, and software — and on making that security research hands-on and
      open rather than hardware-gated.
    </p>
    <div class="hero-links">
      <a href="mailto:ericwhale0@gmail.com" class="hero-contact">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="2"></rect>
          <path d="m22 7-10 5L2 7"></path>
        </svg>
        <span>Contact</span>
      </a>
    </div>
  </section>

  {/* ── Research / About ── */}
  <section class="home-section">
    <h2 class="section-title">// Research</h2>
    <div class="research-card">
      <div class="research-cols">
        <div class="research-block">
          <h3 class="research-label">Interests</h3>
          <ul class="research-list">
            <li><T en="Satellite RF & protocol security" ko="위성 RF·프로토콜 보안" /></li>
            <li><T en="Ground-segment and flight software security" ko="지상국·비행 소프트웨어 보안" /></li>
            <li><T en="Tooling & simulation that lowers the barrier to space-systems research" ko="우주 시스템 연구의 진입장벽을 낮추는 도구·시뮬레이션" /></li>
          </ul>
        </div>
        <div class="research-block">
          <h3 class="research-label">Currently</h3>
          <p class="research-currently">
            <span class="lang-en">
              Ground System Lead in the KHU team for a KARI-hosted CubeSat
              competition; adding new challenges to
              <a href="https://mrradio.kr" target="_blank" rel="noopener">Mr.Radio</a>.
            </span>
            <span class="lang-ko">
              KARI 주최 큐브위성 경진대회 경희대 팀의 지상국 리드,
              <a href="https://mrradio.kr" target="_blank" rel="noopener">Mr.Radio</a>에 새 챌린지 추가 중.
            </span>
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ── Latest Projects ── */}
  <section class="home-section">
    <h2 class="section-title">// Projects</h2>
    <div class="project-grid">
      {latestProjects.map((p) => (
        <a href="/projects" class="project-card">
          <div class="project-thumb">
            {p.data.coverVideo ? (
              <video
                src={p.data.coverVideo}
                width="1600"
                height="900"
                autoplay
                muted
                loop
                playsinline
                preload="auto"
              ></video>
            ) : (
              <img
                src={p.data.cover}
                alt={p.data.title}
                width="1600"
                height="900"
                loading="eager"
              />
            )}
          </div>
          <div class="project-body">
            <h3 class="project-title">{p.data.title}</h3>
            <p class="project-tag"><T en={p.data.tagline} ko={p.data.taglineKo} /></p>
          </div>
        </a>
      ))}
    </div>
    <a href="/projects" class="see-all">All projects →</a>
  </section>

  {/* ── Recent posts ── */}
  {recent.length > 0 && (
    <section class="home-section">
      <h2 class="section-title">// Recent posts</h2>
      <div class="post-list">
        {recent.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            tags={post.data.tags}
            href={`/blog/${post.id}`}
          />
        ))}
      </div>
    </section>
  )}

  {/* ── Starred posts ── */}
  {starred.length > 0 && (
    <section class="home-section">
      <h2 class="section-title">
        <span style="color: var(--accent);">★</span> Starred
      </h2>
      <div class="post-list">
        {starred.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            tags={post.data.tags}
            href={`/blog/${post.id}`}
          />
        ))}
      </div>
    </section>
  )}

  <Sidebar slot="sidebar" />
</BaseLayout>

<style>
  .home-section {
    margin-bottom: 48px;
  }

  /* ── Research / About card ── */
  .research-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px 28px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
  }
  .research-intro {
    color: var(--text-primary);
    font-size: 1.02rem;
    line-height: 1.7;
    margin-bottom: 22px;
  }
  .research-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }
  .research-label {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 10px;
  }
  .research-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .research-list li {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.5;
    padding-left: 14px;
    position: relative;
  }
  .research-list li::before {
    content: "·";
    color: var(--accent);
    position: absolute;
    left: 0;
    font-weight: 700;
  }
  .research-currently {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.65;
  }
  @media (max-width: 640px) {
    .research-cols { grid-template-columns: 1fr; gap: 20px; }
  }

  /* ── Currently card ── */
  .currently-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px 24px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
  }
  .currently-row {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .currently-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .currently-row:first-child {
    padding-top: 0;
  }
  .currently-tag {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    flex-shrink: 0;
    width: 90px;
  }
  .currently-text {
    color: var(--text-primary);
    font-size: 0.95rem;
    line-height: 1.55;
    flex: 1;
  }

  /* ── Latest Project cards ── */
  .see-all {
    display: inline-block;
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent);
  }
  .see-all:hover {
    color: var(--accent-blue);
  }
  .project-grid {
    display: grid;
    /* auto-fit minmax lets the grid flow: 3 cards on wide screens, 2 on
       medium, 1 on narrow — no fixed column count to maintain as cards
       are added or removed. */
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
  }
  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.25s ease;
    color: inherit;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
  }
  .project-card:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
    box-shadow: 0 8px 28px rgba(125, 199, 245, 0.22);
    color: inherit;
  }
  .project-thumb {
    aspect-ratio: 16 / 9;
    background: var(--bg-deep);
    overflow: hidden;
    border-bottom: 1px solid var(--border-subtle);
  }
  .project-thumb img,
  .project-thumb video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Slightly muted by default so bright media sits calmly on the dark page;
       returns to full color + subtle zoom on hover. Keeps the cards unified. */
    filter: brightness(0.85) saturate(0.88);
    transition: transform 0.4s ease, filter 0.3s ease;
  }
  .project-card:hover .project-thumb img,
  .project-card:hover .project-thumb video {
    transform: scale(1.04);
    filter: brightness(1) saturate(1);
  }
  .project-body {
    padding: 16px 18px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .project-title {
    font-family: var(--font-header);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }
  .project-tag {
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.5;
  }
  .project-badge {
    display: inline-block;
    align-self: flex-start;
    background: var(--accent-dim);
    color: var(--accent-strong);
    border: 1px solid rgba(125, 199, 245, 0.3);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    padding: 2px 9px;
    border-radius: 4px;
    margin-top: 4px;
  }
  .project-badge.badge-blue {
    background: var(--accent-blue-dim);
    color: var(--accent-blue);
    border-color: rgba(74, 158, 255, 0.3);
  }

  @media (max-width: 700px) {
    .project-grid { grid-template-columns: 1fr; }
    .currently-row { flex-direction: column; gap: 4px; padding: 12px 0; }
    .currently-tag { width: auto; }
  }
</style>
