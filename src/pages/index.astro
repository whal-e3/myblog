---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import Sidebar from "../components/Sidebar.astro";
import { getCollection } from "astro:content";

const now = new Date();
const allPosts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .filter((p) => !p.data.publishDate || p.data.publishDate <= now);

const starred = allPosts
  .filter((p) => p.data.starred)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const recent = [...allPosts]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="sunhyuk.dev" sidebar>
  <section class="hero">
    <h1 class="hero-title">SunHyuk Hwang</h1>
    <p
      class="hero-rotator"
      aria-label="Satellite security, satellite hacking, security research, flight and ground systems, wireless and RF"
    >
      <span class="rotator-text" data-rotator aria-hidden="true"></span><span
        class="rotator-caret"
        aria-hidden="true"></span>
    </p>
    <div class="hero-links">
      <a href="https://github.com/whal-e3" target="_blank" rel="noopener">GitHub</a>
      <a href="https://x.com/whal_3" target="_blank" rel="noopener">X</a>
      <a href="mailto:ericwhale0@gmail.com">Email</a>
    </div>
  </section>

  {/* ── Recent posts ── */}
  {recent.length > 0 && (
    <section class="home-section">
      <h2 class="section-title">// Recent posts</h2>
      <div class="post-list">
        {recent.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            tags={post.data.tags}
            href={`/blog/${post.id}`}
          />
        ))}
      </div>
    </section>
  )}

  {/* ── Featured Projects ── */}
  <section class="home-section">
    <h2 class="section-title">// Projects</h2>
    <div class="project-grid">
      <a href="/projects" class="project-card">
        <div class="project-thumb">
          <img
            src="/assets/content/project/xxxx_sat/cover.webp"
            alt="xxxx-SAT — 7th CubeSat Competition poster"
            width="1600"
            height="700"
            loading="eager"
          />
        </div>
        <div class="project-body">
          <h3 class="project-title">xxxx-SAT</h3>
          <p class="project-tag">
            Ground System Lead (RLE) for a CubeSat in the 7th Korean CubeSat
            Competition. Designing the Mission Operations Center (MOC) that
            communicates with the satellite.
          </p>
          <span class="project-badge badge-blue">KASA / KARI</span>
        </div>
      </a>

      <a href="/blog/mrradio" class="project-card">
        <div class="project-thumb">
          <img
            src="/assets/content/project/mr_radio/mrradio_wargames.png"
            alt="Mr.Radio wargame interface"
            width="1600"
            height="900"
            loading="eager"
          />
        </div>
        <div class="project-body">
          <h3 class="project-title">Mr.Radio</h3>
          <p class="project-tag">
            World's first virtual RF hacking wargame — receive, demodulate, decode
            satellite signals in the browser.
          </p>
          <span class="project-badge badge-blue">mrradio.kr</span>
        </div>
      </a>

      <a href="https://github.com/whal-e3" target="_blank" rel="noopener" class="project-card">
        <div class="project-thumb">
          <video
            src="/assets/content/project/mr_radio/vsa.mp4"
            width="1600"
            height="900"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
          ></video>
        </div>
        <div class="project-body">
          <h3 class="project-title">OpenVSA</h3>
          <p class="project-tag">
            Virtual satellite ground station — GPredict integration, 3D antenna
            visualization, IQ signal analysis. First of its kind.
          </p>
        </div>
      </a>
    </div>
  </section>

  {/* ── Starred posts ── */}
  {starred.length > 0 && (
    <section class="home-section">
      <h2 class="section-title">
        <span style="color: var(--accent);">★</span> Starred
      </h2>
      <div class="post-list">
        {starred.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            tags={post.data.tags}
            href={`/blog/${post.id}`}
          />
        ))}
      </div>
    </section>
  )}

  <Sidebar slot="sidebar" />
</BaseLayout>

<script is:inline>
  (function () {
    var KEYWORDS = [
      "Satellite security",
      "Satellite hacking",
      "Security research",
      "Flight & ground systems",
      "Wireless & RF",
    ];
    // Held across SPA navigations so a stale animation is cancelled on re-init.
    var timer = null;

    function start() {
      var el = document.querySelector("[data-rotator]");
      if (!el) return;

      if (timer) { clearTimeout(timer); clearInterval(timer); timer = null; }

      var reduce =
        window.matchMedia &&
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduce) {
        // Motion-sensitive users: skip the per-character typing but still cycle
        // the keywords with a plain swap so the line doesn't look frozen.
        var ri = 0;
        el.textContent = KEYWORDS[ri];
        timer = setInterval(function () {
          ri = (ri + 1) % KEYWORDS.length;
          el.textContent = KEYWORDS[ri];
        }, 2600);
        return;
      }

      var i = 0;         // current keyword
      var pos = 0;       // characters shown
      var deleting = false;
      var TYPE = 65;     // ms per typed char
      var ERASE = 35;    // ms per erased char
      var HOLD = 1500;   // pause at full word
      var GAP = 350;     // pause before next word

      function tick() {
        var word = KEYWORDS[i];
        if (!deleting) {
          pos++;
          el.textContent = word.slice(0, pos);
          if (pos === word.length) {
            deleting = true;
            timer = setTimeout(tick, HOLD);
            return;
          }
          timer = setTimeout(tick, TYPE);
        } else {
          pos--;
          el.textContent = word.slice(0, pos);
          if (pos === 0) {
            deleting = false;
            i = (i + 1) % KEYWORDS.length;
            timer = setTimeout(tick, GAP);
            return;
          }
          timer = setTimeout(tick, ERASE);
        }
      }
      tick();
    }

    // Fires on first load and every <ClientRouter /> SPA navigation.
    document.addEventListener("astro:page-load", start);
  })();
</script>

<style>
  .home-section {
    margin-bottom: 48px;
  }

  /* ── Hero rotating keyword ── */
  .hero-rotator {
    font-family: var(--font-header);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 auto 40px;
    /* Reserve the line height so typing/erasing doesn't shift layout. */
    min-height: 1.6em;
    line-height: 1.6;
    letter-spacing: -0.01em;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .rotator-text {
    background: linear-gradient(120deg, var(--accent) 0%, var(--accent-blue) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .rotator-caret {
    display: inline-block;
    width: 3px;
    height: 1.15em;
    margin-left: 4px;
    background: var(--accent);
    animation: rotator-blink 1s steps(1) infinite;
  }
  @keyframes rotator-blink {
    0%, 50% { opacity: 1; }
    50.01%, 100% { opacity: 0; }
  }
  /* Respect reduced-motion: stop the caret blink; the JS also skips typing. */
  @media (prefers-reduced-motion: reduce) {
    .rotator-caret { animation: none; opacity: 0.7; }
  }
  @media (max-width: 640px) {
    .hero-rotator { font-size: 1.2rem; }
  }

  /* ── Currently card ── */
  .currently-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px 24px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
  }
  .currently-row {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .currently-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .currently-row:first-child {
    padding-top: 0;
  }
  .currently-tag {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    flex-shrink: 0;
    width: 90px;
  }
  .currently-text {
    color: var(--text-primary);
    font-size: 0.95rem;
    line-height: 1.55;
    flex: 1;
  }

  /* ── Featured Project cards ── */
  .project-grid {
    display: grid;
    /* auto-fit minmax lets the grid flow: 3 cards on wide screens, 2 on
       medium, 1 on narrow — no fixed column count to maintain as cards
       are added or removed. */
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
  }
  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.25s ease;
    color: inherit;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
  }
  .project-card:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
    box-shadow: 0 8px 28px rgba(125, 199, 245, 0.22);
    color: inherit;
  }
  .project-thumb {
    aspect-ratio: 16 / 9;
    background: var(--bg-deep);
    overflow: hidden;
    border-bottom: 1px solid var(--border-subtle);
  }
  .project-thumb img,
  .project-thumb video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .project-card:hover .project-thumb img,
  .project-card:hover .project-thumb video {
    transform: scale(1.04);
  }
  .project-body {
    padding: 16px 18px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .project-title {
    font-family: var(--font-header);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }
  .project-tag {
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.5;
  }
  .project-badge {
    display: inline-block;
    align-self: flex-start;
    background: var(--accent-dim);
    color: var(--accent-strong);
    border: 1px solid rgba(125, 199, 245, 0.3);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    padding: 2px 9px;
    border-radius: 4px;
    margin-top: 4px;
  }
  .project-badge.badge-blue {
    background: var(--accent-blue-dim);
    color: var(--accent-blue);
    border-color: rgba(74, 158, 255, 0.3);
  }

  @media (max-width: 700px) {
    .project-grid { grid-template-columns: 1fr; }
    .currently-row { flex-direction: column; gap: 4px; padding: 12px 0; }
    .currently-tag { width: auto; }
  }
</style>
