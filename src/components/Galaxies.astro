---
// Fullscreen nebula background — completely static. The image is fixed, so it
// stays put while the page content scrolls (no motion at all). Earlier drifting
// stars and a scroll parallax were both removed because the movement was
// distracting / could cause motion discomfort.
---

<div class="space-bg" aria-hidden="true">
  <img class="space-img" src="/assets/space-bg.webp" alt="" />
</div>
<div class="space-overlay" aria-hidden="true"></div>

<style>
  .space-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .space-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Heavy dark veil: the photo sinks to a subtle deep-space texture so text
     sits on a near-solid dark background (clean, readable). */
  .space-overlay {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 90% 80% at center,
        rgba(5, 3, 8, 0.68) 0%,
        rgba(5, 3, 8, 0.76) 55%,
        rgba(5, 3, 8, 0.85) 100%);
  }
</style>
