---
// Fullscreen nebula background + a slow, sparse drifting star field on a
// <canvas>. The drift is autonomous (a gentle sideways glide, like a
// screensaver) — NOT coupled to scroll, which is what previously felt
// nauseating. Tuned sparse / dim / slow so it stays calm and unobtrusive.

type Star = { x: number; y: number; size: number; color: string };

function rand(seed: number) {
  let s = seed >>> 0;
  return () => {
    s = (s * 1664525 + 1013904223) >>> 0;
    return s / 0x100000000;
  };
}

type Layer = "near" | "mid" | "far";

function makeStars(seed: number, count: number, layer: Layer): Star[] {
  const rng = rand(seed);
  const out: Star[] = [];
  const profile = {
    near: { sizeMin: 2.0, sizeMax: 3.0 },
    mid:  { sizeMin: 1.3, sizeMax: 2.0 },
    far:  { sizeMin: 0.7, sizeMax: 1.3 },
  }[layer];

  for (let i = 0; i < count; i++) {
    const r = rng();
    let color: string;
    if (r < 0.80) {
      // 80% white / pale-blue — matches the milky way background
      const sub = rng();
      if (sub < 0.45) color = "#ffffff";
      else if (sub < 0.75) color = "#e8f0ff";
      else if (sub < 0.92) color = "#c8d8ff";
      else color = "#a8c8ff";
    } else if (r < 0.95) {
      // 15% pale yellow
      const sub = rng();
      if (sub < 0.60) color = "#fff5d8";
      else color = "#ffe8a8";
    } else {
      // 5% saturated cool sparks
      color = rng() < 0.5 ? "#5eb0e8" : "#4a9eff";
    }

    out.push({
      x: rng() * 100,
      y: rng() * 100,
      size: profile.sizeMin + rng() * (profile.sizeMax - profile.sizeMin),
      color,
    });
  }
  return out;
}

// Sparse / dim / slow. `dur` = seconds to drift one viewport width (bigger =
// slower). These are deliberately high so the motion is barely-there calm.
const layerData = [
  { dur: 1000, opacity: 0.55, stars: makeStars(11111, 55, "far") },
  { dur: 680,  opacity: 0.78, stars: makeStars(22222, 30, "mid") },
  { dur: 430,  opacity: 1.0,  stars: makeStars(33333, 15, "near") },
].map((l) => ({
  dur: l.dur,
  opacity: l.opacity,
  stars: l.stars.map((s) => ({
    x: +s.x.toFixed(2),
    y: +s.y.toFixed(2),
    r: +(s.size / 2).toFixed(2),
    c: s.color,
  })),
}));
---

<div class="space-bg" aria-hidden="true">
  <img class="space-img" src="/assets/space-bg.webp" alt="" />
</div>
<div class="space-overlay" aria-hidden="true"></div>
<canvas
  id="star-canvas"
  class="star-canvas"
  aria-hidden="true"
  data-layers={JSON.stringify(layerData)}
></canvas>

<style>
  .space-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .space-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .space-overlay {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 90% 80% at center,
        rgba(5, 3, 8, 0.68) 0%,
        rgba(5, 3, 8, 0.76) 55%,
        rgba(5, 3, 8, 0.85) 100%);
  }
  .star-canvas {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    width: 100vw;
    height: 100vh;
    display: block;
  }
</style>

<script is:inline>
  (function () {
    var rafId = null;
    var onResize = null;
    var onVisibility = null;

    function init() {
      var canvas = document.getElementById("star-canvas");
      if (!canvas) return;

      if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
      if (onResize) window.removeEventListener("resize", onResize);
      if (onVisibility) document.removeEventListener("visibilitychange", onVisibility);

      var layers;
      try { layers = JSON.parse(canvas.getAttribute("data-layers")); } catch (e) { return; }

      var ctx = canvas.getContext("2d");
      if (!ctx) return;
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      var W = 0, H = 0;

      function resize() {
        W = window.innerWidth;
        H = window.innerHeight;
        canvas.width = Math.floor(W * dpr);
        canvas.height = Math.floor(H * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      resize();

      var reduce =
        window.matchMedia &&
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var TWO_PI = Math.PI * 2;

      function draw(elapsedSec) {
        ctx.clearRect(0, 0, W, H);
        for (var li = 0; li < layers.length; li++) {
          var layer = layers[li];
          var speed = W / layer.dur;          // px/sec, drifting left
          var shift = (elapsedSec * speed) % W;
          ctx.globalAlpha = layer.opacity;
          var stars = layer.stars;
          for (var i = 0; i < stars.length; i++) {
            var s = stars[i];
            var x = (s.x / 100) * W - shift;
            if (x < 0) x += W;
            var y = (s.y / 100) * H;
            ctx.beginPath();
            ctx.fillStyle = s.c;
            ctx.arc(x, y, s.r, 0, TWO_PI);
            ctx.fill();
          }
        }
        ctx.globalAlpha = 1;
      }

      onResize = function () { resize(); if (reduce) draw(0); };
      window.addEventListener("resize", onResize);

      // Motion-sensitive users: draw once, no animation loop.
      if (reduce) { draw(0); return; }

      var startTs = null;
      function frame(ts) {
        if (startTs === null) startTs = ts;
        draw((ts - startTs) / 1000);
        rafId = requestAnimationFrame(frame);
      }
      rafId = requestAnimationFrame(frame);

      // Pause when the tab is hidden (saves CPU/battery).
      onVisibility = function () {
        if (document.hidden) {
          if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
        } else if (!rafId) {
          startTs = null;
          rafId = requestAnimationFrame(frame);
        }
      };
      document.addEventListener("visibilitychange", onVisibility);
    }

    document.addEventListener("astro:page-load", init);
  })();
</script>
