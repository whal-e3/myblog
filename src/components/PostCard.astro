---
interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  href: string;
}

const { title, description, date, tags, href } = Astro.props;

function formatDate(d: Date) {
  return d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---

<a href={href} class="post-card">
  <div class="post-card-title">{title}</div>
  <div class="post-card-desc">{description}</div>
  <div class="post-card-meta">
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    {tags.length > 0 && (
      <div class="post-tags">
        {tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )}
  </div>
</a>
