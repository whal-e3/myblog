---
// 태극기 — compact inline SVG so it renders on every OS (Windows Segoe UI Emoji
// has no regional-flag glyphs, so the 🇰🇷 emoji shows as "KR" there).
---
<svg class="flag-icon" viewBox="0 0 36 24" role="img" aria-label="한국어">
  <rect width="36" height="24" fill="#fff" />
  {/* Taegeuk */}
  <circle cx="18" cy="12" r="6" fill="#CD2E3A" />
  <path
    d="M18 6 A6 6 0 0 1 18 18 A3 3 0 0 1 18 12 A3 3 0 0 0 18 6 Z"
    fill="#0047A0"
    transform="rotate(90 18 12)"
  />
  {/* Trigrams (black) — TL Geon, TR Gam, BL Ri, BR Gon */}
  <g fill="#111">
    {/* Geon ☰ (top-left): 3 solid */}
    <g transform="translate(7 5)">
      <rect x="-2.6" y="-1.7" width="5.2" height="0.8" />
      <rect x="-2.6" y="-0.4" width="5.2" height="0.8" />
      <rect x="-2.6" y="0.9" width="5.2" height="0.8" />
    </g>
    {/* Gam ☵ (top-right): broken, solid, broken */}
    <g transform="translate(29 5)">
      <rect x="-2.6" y="-1.7" width="2.1" height="0.8" /><rect x="0.5" y="-1.7" width="2.1" height="0.8" />
      <rect x="-2.6" y="-0.4" width="5.2" height="0.8" />
      <rect x="-2.6" y="0.9" width="2.1" height="0.8" /><rect x="0.5" y="0.9" width="2.1" height="0.8" />
    </g>
    {/* Ri ☲ (bottom-left): solid, broken, solid */}
    <g transform="translate(7 19)">
      <rect x="-2.6" y="-1.7" width="5.2" height="0.8" />
      <rect x="-2.6" y="-0.4" width="2.1" height="0.8" /><rect x="0.5" y="-0.4" width="2.1" height="0.8" />
      <rect x="-2.6" y="0.9" width="5.2" height="0.8" />
    </g>
    {/* Gon ☷ (bottom-right): 3 broken */}
    <g transform="translate(29 19)">
      <rect x="-2.6" y="-1.7" width="2.1" height="0.8" /><rect x="0.5" y="-1.7" width="2.1" height="0.8" />
      <rect x="-2.6" y="-0.4" width="2.1" height="0.8" /><rect x="0.5" y="-0.4" width="2.1" height="0.8" />
      <rect x="-2.6" y="0.9" width="2.1" height="0.8" /><rect x="0.5" y="0.9" width="2.1" height="0.8" />
    </g>
  </g>
</svg>
