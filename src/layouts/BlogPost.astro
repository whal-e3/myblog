---
import BaseLayout from "./BaseLayout.astro";
import Comments from "../components/Comments.astro";

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  comments?: boolean;
  sidebar?: boolean;
}

const { title, description, date, tags, comments = true, sidebar = false } = Astro.props;

function formatDate(d: Date) {
  return d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<BaseLayout title={title} description={description} sidebar={sidebar}>
  <article class="post-paper">
    <div class="post-header">
      <h1 class="post-title">{title}</h1>
      <div class="post-meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map((tag) => (
              <a href={`/tags/${tag}`} class="tag">{tag}</a>
            ))}
          </div>
        )}
      </div>
    </div>
    <div class="prose">
      <slot />
    </div>
    {comments && <Comments />}
  </article>
  <slot name="sidebar" slot="sidebar" />
</BaseLayout>

<style>
  /* Subtle dark backdrop behind the post so prose stays readable on the
     nebula background. Same look as the CV page's .cv-paper for consistency. */
  .post-paper {
    background: rgba(10, 5, 16, 0.62);
    border: 1px solid rgba(245, 230, 212, 0.12);
    border-radius: 16px;
    padding: 48px 60px 44px;
    box-shadow:
      0 10px 40px rgba(0, 0, 0, 0.5),
      inset 0 0 60px rgba(245, 230, 212, 0.02);
  }

  @media (max-width: 768px) {
    .post-paper {
      padding: 28px 22px 24px;
      border-radius: 12px;
    }
  }
</style>

<style is:global>
  /* Tighten the figure/figcaption layout so captions sit close under their
     image instead of floating with the browser-default 16-40px gap. */
  .prose figure {
    margin: 1.4em auto 0.5em;
  }
  .prose figure img {
    display: block;
    margin: 0 auto;
  }
  .prose figcaption {
    margin-top: 4px;
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--text-muted);
    text-align: center;
  }
  .prose figcaption code {
    font-size: 0.82rem;
  }
</style>
