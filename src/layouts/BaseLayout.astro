---
import Galaxies from "../components/Galaxies.astro";
import KrFlag from "../components/KrFlag.astro";
import UsFlag from "../components/UsFlag.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  sidebar?: boolean;
}

const { title, description = "Hacking, Space, and AI.", sidebar = false } = Astro.props;
const siteTitle = "sunhyuk.dev";

// Active-nav helper: marks the matching nav link as the current page
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Apply the saved language before first paint (no flash of the wrong language) */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        // Country-based default stamped by the Cloudflare Worker (KR → ko, else
        // en); falls back to en in dev where no Worker runs.
        var def = root.getAttribute("data-default-lang") || "en";
        var l = def;
        try {
          var s = localStorage.getItem("lang"); // explicit user choice wins
          if (s === "ko" || s === "en") l = s;
        } catch (e) {}
        root.dataset.lang = l;
        root.lang = l;
      })();
    </script>
    <meta name="description" content={description} />
    <title>{title === siteTitle ? title : `${title} — ${siteTitle}`}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* KaTeX styles for math rendering in posts */}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5+" crossorigin="anonymous" />
    {/* SPA-style navigation */}
    <ClientRouter />
  </head>
  <body>
    <Galaxies />
    <div class="page-wrapper">
      <header>
        <div class="container header-row">
          <a href="/" class="site-title">{siteTitle}</a>
          <div class="header-right">
            <nav class="nav-desktop">
              <a href="/blog"     class:list={[{ "is-current": isCurrent("/blog") }]}     aria-current={isCurrent("/blog")     ? "page" : undefined}>Blog</a>
              <a href="/projects" class:list={[{ "is-current": isCurrent("/projects") }]} aria-current={isCurrent("/projects") ? "page" : undefined}>Projects</a>
              <a href="/cv"       class:list={[{ "is-current": isCurrent("/cv") }]}       aria-current={isCurrent("/cv")       ? "page" : undefined}>CV</a>
            </nav>
            <button class="lang-toggle" type="button" aria-label="Toggle language / 언어 전환">
              <span class="lang-en"><KrFlag /></span><span class="lang-ko"><UsFlag /></span>
            </button>
            <button
              class="menu-toggle"
              type="button"
              aria-label="Open menu"
              aria-controls="sidebar-drawer"
              aria-expanded="false"
            >
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <line x1="4" y1="7" x2="20" y2="7" />
                <line x1="4" y1="12" x2="20" y2="12" />
                <line x1="4" y1="17" x2="20" y2="17" />
              </svg>
            </button>
          </div>
        </div>
      </header>
      <main>
        <div class={`container ${sidebar ? "with-sidebar" : ""}`}>
          <div class="main-content">
            <slot />
          </div>
          <div class="sidebar-col" id="sidebar-drawer">
            <button
              class="drawer-close"
              type="button"
              aria-label="Close menu"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <line x1="6" y1="6" x2="18" y2="18" />
                <line x1="18" y1="6" x2="6" y2="18" />
              </svg>
            </button>
            <nav class="nav-mobile">
              <a href="/blog"     class:list={[{ "is-current": isCurrent("/blog") }]}     aria-current={isCurrent("/blog")     ? "page" : undefined}>Blog</a>
              <a href="/projects" class:list={[{ "is-current": isCurrent("/projects") }]} aria-current={isCurrent("/projects") ? "page" : undefined}>Projects</a>
              <a href="/cv"       class:list={[{ "is-current": isCurrent("/cv") }]}       aria-current={isCurrent("/cv")       ? "page" : undefined}>CV</a>
            </nav>
            <slot name="sidebar" />
          </div>
          <div class="sidebar-backdrop" aria-hidden="true"></div>
        </div>
      </main>
      <footer>
        <div class="container">
          <div class="footer-links">
            <a href="https://github.com/whal-e3" target="_blank" rel="noopener">GitHub</a>
            &nbsp;·&nbsp;
            <a href="https://x.com/whal_3" target="_blank" rel="noopener">X</a>
            &nbsp;·&nbsp;
            <a href="mailto:ericwhale0@gmail.com">Email</a>
          </div>
          <p class="footer-copyright">
            <span class="lang-en">
              © 2026 SunHyuk Hwang. All rights reserved. No content herein may be
              reproduced, distributed, or transmitted in any form without the prior
              written consent of the copyright holder.
            </span>
            <span class="lang-ko">
              © 2026 황선혁. All rights reserved. 저작권자의 사전 서면 동의 없이는 본
              사이트의 어떠한 콘텐츠도 어떤 형태로든 복제·배포·전송할 수 없습니다.
            </span>
          </p>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";

  /* ── Language toggle: show only the active language ── */
  :root[data-lang="en"] .lang-ko { display: none !important; }
  :root[data-lang="ko"] .lang-en { display: none !important; }

  .lang-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    padding: 2px;
    cursor: pointer;
    transition: transform 0.15s;
    line-height: 0;
  }
  .lang-toggle:hover {
    transform: translateY(-1px);
  }
  .lang-toggle span {
    display: inline-flex;
    line-height: 0;
  }
  .flag-icon {
    width: 22px;
    height: auto;
    display: block;
    border-radius: 2px;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.12);
  }

  /* Mobile: the header row (title · nav · flag · hamburger) gets tight, so
     shrink the flag and its padding to stop it colliding with the menu button. */
  @media (max-width: 768px) {
    .flag-icon { width: 18px; }
    .lang-toggle { padding: 2px 5px; margin-left: 2px; }
  }
  @media (max-width: 480px) {
    .flag-icon { width: 16px; }
    .lang-toggle { padding: 2px 3px; }
  }
</style>

<script>
  // ── Document-level listeners — register ONCE across the SPA lifetime ──
  function closeDrawer() {
    document.body.classList.remove("sidebar-open");
    document.querySelector(".menu-toggle")?.setAttribute("aria-expanded", "false");
  }

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && document.body.classList.contains("sidebar-open")) {
      closeDrawer();
    }
  });

  // ── Language: re-apply the saved choice after every SPA navigation ──
  function applyLang() {
    const root = document.documentElement;
    let l = root.getAttribute("data-default-lang") || "en";
    try {
      const s = localStorage.getItem("lang");
      if (s === "ko" || s === "en") l = s;
    } catch (e) {}
    root.dataset.lang = l;
    root.lang = l;
  }
  document.addEventListener("astro:after-swap", applyLang);

  // ── Element-specific listeners — re-register on every SPA page-load ──
  function wirePageElements() {
    const toggle   = document.querySelector<HTMLButtonElement>(".menu-toggle");
    const closeBtn = document.querySelector<HTMLButtonElement>(".drawer-close");
    const backdrop = document.querySelector<HTMLDivElement>(".sidebar-backdrop");

    function openDrawer() {
      document.body.classList.add("sidebar-open");
      toggle?.setAttribute("aria-expanded", "true");
    }
    function toggleDrawer() {
      if (document.body.classList.contains("sidebar-open")) closeDrawer();
      else openDrawer();
    }

    toggle?.addEventListener("click", toggleDrawer);
    closeBtn?.addEventListener("click", closeDrawer);
    backdrop?.addEventListener("click", closeDrawer);

    // Language toggle
    const langBtn = document.querySelector<HTMLButtonElement>(".lang-toggle");
    langBtn?.addEventListener("click", () => {
      const next =
        document.documentElement.dataset.lang === "ko" ? "en" : "ko";
      try {
        localStorage.setItem("lang", next);
      } catch (e) {}
      document.documentElement.dataset.lang = next;
      document.documentElement.lang = next;
    });

    // Auto-close drawer when any link inside it is clicked
    document.querySelectorAll<HTMLAnchorElement>(".sidebar-col a").forEach((link) => {
      link.addEventListener("click", closeDrawer);
    });
  }

  // ── Cover videos: force autoplay after every navigation ──
  // With <ClientRouter />, `autoplay` only fires when the browser parses the
  // element on a full page load. After an SPA swap the video element is inserted
  // via script, so it neither auto-plays nor necessarily starts loading — it
  // just sits blank until a hard refresh. Re-kick loading, then play once it can.
  function playCoverVideos() {
    document.querySelectorAll<HTMLVideoElement>("video[autoplay]").forEach((v) => {
      v.muted = true; // required for programmatic autoplay
      v.playsInline = true;
      const play = () => {
        const p = v.play();
        if (p && typeof p.catch === "function") p.catch(() => {});
      };
      if (v.readyState >= 2) {
        play();
      } else {
        v.addEventListener("canplay", play, { once: true });
        try { v.load(); } catch (e) {}
      }
    });
  }

  // Run on initial load + every SPA transition. `astro:page-load` fires on the
  // first load too, so we must NOT also call wirePageElements() directly —
  // doing both double-binds every click handler (the language toggle would flip
  // twice per click and appear to do nothing).
  document.addEventListener("astro:page-load", () => {
    wirePageElements();
    playCoverVideos();
  });
  // Also right after the DOM swap (fires before page-load) so the video starts
  // loading as early as possible.
  document.addEventListener("astro:after-swap", playCoverVideos);
</script>
