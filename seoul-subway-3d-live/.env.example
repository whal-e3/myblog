# Request your own realtime subway service key from Seoul Open Data Plaza.
# Copy this file to .env, paste the key below, then restart server.py.
SEOUL_SUBWAY_API_KEY=PASTE_YOUR_KEY_HERE

# The default requests live reports only for Line 2. Other routes remain map-only.
# Set SEOUL_LIVE_LINES=all to enable all 19 candidate routes, or use comma-separated
# route IDs. The API may return no data or an error for individual routes.
SEOUL_LIVE_LINES=2
SEOUL_POLL_SECONDS=120

# Local protective cap below the provider's 1,000-request daily allowance.
# At 120 seconds, one single-page route needs 720 requests per full day. All
# 19 routes need at least 13,680/day, before any extra pages: a 900-call cap
# cannot keep all routes fresh all day. The feed stops at the cap; raise it only
# if your approved provider quota permits that many calls. Multiple tabs share
# the cache/ledger, and pagination uses one request per page.
SEOUL_DAILY_LIMIT=900

# The documented swopenapi endpoint is HTTP. The key travels in its URL.
# Set https ONLY if HTTPS is supported for this service in your environment.
# No automatic protocol downgrade or off-domain redirect is performed.
SEOUL_API_SCHEME=http
