# Request your own realtime subway service key from Seoul Open Data Plaza.
# Copy this file to .env, paste the key below, then restart server.py.
SEOUL_SUBWAY_API_KEY=PASTE_YOUR_KEY_HERE

# The public map uses live reports only for Line 2. Other routes remain map-only.
# Hidden lines are not polled.
SEOUL_LIVE_LINES=2
SEOUL_POLL_SECONDS=120

# Local protective cap below the provider's 1,000-request daily allowance.
# Pagination uses one request per page. Multiple tabs share the cache/ledger.
SEOUL_DAILY_LIMIT=900

# The documented swopenapi endpoint is HTTP. The key travels in its URL.
# Set https ONLY if HTTPS is supported for this service in your environment.
# No automatic protocol downgrade or off-domain redirect is performed.
SEOUL_API_SCHEME=http
